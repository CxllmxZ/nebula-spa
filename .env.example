# ============================================
# Nebula Spa — Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local or .dev.vars to git

# --- Better Auth ---
# Random 32+ character secret used to sign session tokens
# Generate: openssl rand -base64 32
# (Windows PowerShell: [Convert]::ToBase64String((1..32 | %{Get-Random -Max 256})))
BETTER_AUTH_SECRET=replace_with_32_char_random_string

# Base URL of your app (used for auth redirects)
# Local dev = http://localhost:3000
# Production = https://nebula-spa.YOURSUBDOMAIN.workers.dev
BETTER_AUTH_URL=http://localhost:3000

# --- Admin Seed ---
# Used once when seeding initial admin user (seed script only)
ADMIN_SEED_EMAIL=admin@nebula-spa.demo
ADMIN_SEED_PASSWORD=change_me_before_seeding

# --- LINE Messaging API ---
# Get from LINE Developers Console > your channel > Messaging API tab
# https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret

# User ID of the shop owner (who receives booking notifications)
# Get by: follow your OA with LINE personal, then webhook logs or LINE OA Manager
LINE_OWNER_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_ENABLED=false

# --- Cloudflare Turnstile (anti-spam CAPTCHA) ---
# Get from Cloudflare Dashboard > Turnstile > Add site
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Drizzle Kit (for D1 remote migrations) ---
# Get from Cloudflare Dashboard > profile icon > API Tokens > Create Token
# Template: "Edit Cloudflare Workers" or Custom with D1:Edit permission
CLOUDFLARE_ACCOUNT_ID=your_account_id_from_dashboard_sidebar
CLOUDFLARE_D1_DATABASE_ID=set_after_wrangler_d1_create
CLOUDFLARE_D1_TOKEN=your_api_token_with_d1_edit_permission